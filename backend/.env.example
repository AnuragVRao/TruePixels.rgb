# TruePixels.rgb - Environment Template
APP_NAME=TruePixels.rgb
# "development" enables the dev-only surface: /docs, the legacy dashboard at
# /, console OTP delivery, plain-http CORS defaults. UNSET means production.
ENVIRONMENT=development
# Shared secret between Caddy and the API (docs/https.md): the API trusts
# X-Forwarded-For / -Proto only on requests that carry it. Generate with
#   python -c "import secrets; print(secrets.token_hex(32))"
PROXY_SHARED_SECRET=
# Cross-origin callers allowed (comma separated). Leave unset: the React app is
# same-origin behind Caddy. In production set only HTTPS origins, if any.
# TRUEPIXELS_CORS_ORIGINS=https://truepixels.example.com
DEBUG=True

# Database. PostgreSQL is the target (compose.yaml at the repo root runs it on
# 127.0.0.1:5433). The POSTGRES_* values are read by that container; choose a
# password and use the SAME three values in DATABASE_URL. Then, once:
#   docker compose --env-file backend/.env up -d db && cd backend && alembic upgrade head
POSTGRES_USER=truepixels
POSTGRES_PASSWORD=
POSTGRES_DB=truepixels
DATABASE_URL=postgresql+psycopg://truepixels:<the-password-above>@127.0.0.1:5433/truepixels
# SQLite instead (no Docker): comment the line above and use
# DATABASE_URL=sqlite:///./truepixels.db
# Connection pool (PostgreSQL only; see app/shared/db.py for the reasoning)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800

# Security & JWT Session
# REQUIRED before deploying, and whenever you run more than one worker.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# Leave unset locally and M1 generates a random key per process (sessions
# then end at every restart, which is the safe default).
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
SESSION_EXPIRE_HOURS=8

# Storage Paths & Limits
# STORAGE_DIR defaults to the repository-root storage/ shared by M1, M2 and M3.
# A relative value is resolved against the directory uvicorn is started from.
# STORAGE_DIR=../storage
MAX_UPLOAD_SIZE_MB=10
MIN_IMAGE_DIMENSION=64
MAX_IMAGE_PIXELS=25000000

# Email Service Configuration (2FA / OTP)
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password
SMTP_FROM=your_email@gmail.com
SMTP_USE_SSL=False
OTP_EXPIRE_MINUTES=5
REQUIRE_2FA=True

# First admin account (backend/seed_admin.py). Unset = a random password is
# generated and printed once. Never commit a real value.
# SEED_ADMIN_EMAIL=admin@truepixels.rgb
# SEED_ADMIN_PASSWORD=
