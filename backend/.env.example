# TruePixels.rgb - Environment Template
APP_NAME=TruePixels.rgb
ENVIRONMENT=development
DEBUG=True

# Database Configuration (defaults to SQLite if not PostgreSQL)
DATABASE_URL=sqlite:///./truepixels.db

# Security & JWT Session
# REQUIRED before deploying, and whenever you run more than one worker.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# Leave unset locally and M1 generates a random key per process (sessions
# then end at every restart, which is the safe default).
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
SESSION_EXPIRE_HOURS=8

# Storage Paths & Limits
# STORAGE_DIR defaults to the repository-root storage/ shared by M1, M2 and M3.
# A relative value is resolved against the directory uvicorn is started from.
# STORAGE_DIR=../storage
MAX_UPLOAD_SIZE_MB=10
MIN_IMAGE_DIMENSION=64
MAX_IMAGE_PIXELS=25000000

# Email Service Configuration (2FA / OTP)
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password
SMTP_FROM=your_email@gmail.com
SMTP_USE_SSL=False
OTP_EXPIRE_MINUTES=5
REQUIRE_2FA=True

# First admin account (backend/seed_admin.py). Unset = a random password is
# generated and printed once. Never commit a real value.
# SEED_ADMIN_EMAIL=admin@truepixels.rgb
# SEED_ADMIN_PASSWORD=
